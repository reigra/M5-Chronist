# Caddy obtains and renews the Let's Encrypt certificates automatically.
# Canonical origin is www.{$DOMAIN}: the PWA's storage (IndexedDB) is bound
# to exactly one origin, so the bare domain only redirects.
www.{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:80
}

{$DOMAIN} {
	redir https://www.{$DOMAIN}{uri} permanent
}
